# Local Postgres settings used by Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=next_books
POSTGRES_HOST=localhost
POSTGRES_PORT=5471

# Leave blank to run against the generated preview catalog instead of a
# database — the e2e suite does exactly that. @next/env expands these values
# for database scripts that run outside the Next.js runtime.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Absolute URL used for metadataBase / Open Graph. Falls back to
# VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_BASE_URL=

# Point the Playwright suite at an already-running dev server.
PLAYWRIGHT_BASE_URL=

# Seed knobs (pnpm db:seed-authors / db:seed-books). Paths default to the
# newline-delimited dumps under lib/db; the totals cap how much gets imported.
AUTHORS_DATA_PATH=
BOOKS_DATA_PATH=
AUTHORS_CHECKPOINT_PATH=
BOOKS_CHECKPOINT_PATH=
TOTAL_AUTHORS=
TOTAL_BOOKS=
