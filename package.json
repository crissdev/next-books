{
  "name": "next-books",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11.26.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "next build && next experimental-analyze",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed-authors && pnpm db:seed-books",
    "db:seed-authors": "tsx lib/db/seed-authors.ts",
    "db:seed-books": "tsx lib/db/seed-books.ts",
    "db:seed-thumbhash": "tsx lib/db/seed-thumbhash.ts"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.39",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.4.0-canary.25",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "thumbhash": "^0.1.1",
    "unlazy": "^2.0.1"
  },
  "devDependencies": {
    "@next/playwright": "16.4.0-canary.25",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0-canary.25",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-autofix": "^2.2.0",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
